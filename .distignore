# Files excluded from the WordPress.org distribution zip.
# The colophon CLI and WP.org deploy tooling both read this file.

# Internal CLI tooling — not for distribution
inc/github-updater.php
inc/cli.php

# Internal tooling manifests
colophon.json
.distignore

# Developer tooling
PILLARS.md
*.sh
bin/

# Community health / repo-only files — belong on GitHub, not the WP.org zip
# (flagged by the theme review team on ticket #282661)
README.md
SECURITY.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md

# Preview system
preview/

# WordPress.org directory listing assets (banner/icon) — pushed to the SVN
# assets/ path by .github/workflows/deploy-wporg-assets.yml, never bundled
# into the installed theme itself
.wporg-assets/

# Version-control artefacts
.git
.github
.gitignore
.gitattributes

# Translator documentation (not needed in distributed theme)
languages/README.md
